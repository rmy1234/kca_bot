APP_NAME="정보보안기사 AI 학습 프로그램 API"
# Any value other than "development" (e.g. production) requires a real JWT_SECRET_KEY.
ENVIRONMENT=development
# The SQLite file is created in backend/ on first start and seeded with the exam curriculum.
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kca_bot
DATABASE_URL=sqlite+aiosqlite:///./kca_bot.db

# LLM: local model through Ollama (https://ollama.com). Install Ollama, then run `ollama pull qwen3.5:9b`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Context window for the prompt plus the generated JSON; lower it if VRAM runs short.
OLLAMA_NUM_CTX=16384
# Thinking mode can improve reasoning but is much slower on local GPUs.
OLLAMA_THINK=false
OLLAMA_TIMEOUT_SECONDS=600
# Optional: model used automatically when OLLAMA_MODEL returns a usage limit (429) or needs credits (402),
# e.g. OLLAMA_MODEL=gemma4:cloud with OLLAMA_FALLBACK_MODEL=qwen3.5:9b. Cloud models need `ollama signin`
# and send prompts to Ollama's servers. The primary model is retried after OLLAMA_FALLBACK_MINUTES.
OLLAMA_FALLBACK_MODEL=
OLLAMA_FALLBACK_MINUTES=60

# Optional alternative: Gemini API. Set LLM_PROVIDER=gemini and a key.
# LLM_PROVIDER=gemini with an empty key uses a deterministic mock generator (useful for UI work without a model).
# GEMINI_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# Auth. Generate a separate secret on each machine:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Frontend origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# Optional: if both are set, this account is created as an admin on startup (required for 콘텐츠 관리).
# Avoid reserved/special-use TLDs here (.local, .test, .example, .invalid, .localhost) -
# email-validator rejects them when logging in through POST /auth/login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
